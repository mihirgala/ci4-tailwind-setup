{
  "name": "ci4-tailwind-setup",
  "version": "1.0.0",
  "private": true,
  "description": "CodeIgniter 4 + Tailwind CSS 4 starter with modular PHP views, a development workspace, and agent skills.",
  "scripts": {
    "setup": "php -r \"file_exists('.env')||copy('.env.example','.env');\"",
    "dev": "tailwindcss -i ./assets/css/input.css -o ./public/css/output.css --watch",
    "build": "tailwindcss -i ./assets/css/input.css -o ./public/css/output.css --minify",
    "php": "php spark serve",
    "lint": "php scripts/lint.php",
    "check": "php scripts/lint.php && pnpm build",
    "prepare": "node -e \"require('fs').existsSync('.git')&&require('child_process').execSync('git config core.hooksPath .githooks')\"",
    "skills:sync": "php scripts/sync-skills.php"
  },
  "keywords": [
    "codeigniter",
    "tailwindcss",
    "php",
    "starter"
  ],
  "author": "Mihir Gala",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mihirgala/ci4-tailwind-setup.git"
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.2.4",
    "tailwindcss": "^4.2.4"
  }
}
